# =============================================================================
# ECHO WorkforceOS - environment template
#
#   cp .env.example .env                 # backend reads ./.env and ../.env
#   cp .env.example frontend/.env.local  # frontend reads NEXT_PUBLIC_* only
#
# Every service used here has a free tier. Nothing paid is required.
# Values marked [REQUIRED] must be set. Everything else has a working default
# and the matching feature simply stays dormant until you fill it in.
# =============================================================================


# -----------------------------------------------------------------------------
# ENVIRONMENT                                                       [REQUIRED]
# -----------------------------------------------------------------------------
APP_NAME=Echo Enterprise Autonomous Workforce
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
PORT=8000
ENABLE_STRUCTURED_LOGGING=true


# -----------------------------------------------------------------------------
# APPLICATION URLS                                                  [REQUIRED]
# -----------------------------------------------------------------------------
API_V1_STR=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=*                   # comma separated list, or * for any origin


# -----------------------------------------------------------------------------
# SUPABASE                                                          [REQUIRED]
#
# Free tier: https://supabase.com -> New project
#   Project URL / anon key : Settings -> API
#   Service role key       : Settings -> API -> service_role (keep server-side)
#
# Before first run, paste backend/database/schema.sql into
# Supabase -> SQL Editor -> New query -> Run.
#
# Leave these as placeholders to run fully offline on SQLite instead - the
# backend detects the missing project and falls back automatically.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=echo-documents
SUPABASE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# DATABASE                                                          [REQUIRED]
#
# Used when Supabase is not configured, and by tooling that needs a direct
# connection. Supabase -> Settings -> Database -> Connection string (URI).
#   Local offline default : sqlite:///./echo.db
#   Supabase Postgres     : postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./echo.db


# -----------------------------------------------------------------------------
# AUTHENTICATION                                                    [REQUIRED]
#
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_EXPIRY_HOURS=72


# -----------------------------------------------------------------------------
# LLM                                                               [OPTIONAL]
#
# Agents reason deterministically from config/rules.yaml when no key is set,
# so the demo runs without one. A key adds natural-language reasoning to
# verification reports and planning summaries.
#
#   Gemini (preferred, free) : https://aistudio.google.com/app/apikey
#   Groq (free)              : https://console.groq.com/keys
#
# LLM_PROVIDER=auto tries Gemini, then Groq, then OpenAI, then rules.
# -----------------------------------------------------------------------------
LLM_PROVIDER=auto                # auto | gemini | groq | openai | rules
GEMINI_API_KEY=                  # [OPTIONAL] preferred
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=                    # [OPTIONAL]
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=                  # [OPTIONAL]
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# EMAIL - Gmail SMTP                                                [OPTIONAL]
#
# Free with any Google account. SMTP_PASSWORD must be a 16-character App
# Password (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal password.
#
# With ENABLE_EMAIL=false every message is still recorded in the email_outbox
# table and visible in the UI, so invitations work without SMTP.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                       # [OPTIONAL] your.name@gmail.com
SMTP_PASSWORD=                   # [OPTIONAL] 16-char Google App Password
SMTP_FROM=ECHO WorkforceOS <no-reply@echo.local>
SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR                                                   [OPTIONAL]
#
# Free API. https://console.cloud.google.com -> APIs & Services
#   1. Enable "Google Calendar API"
#   2. Create an OAuth 2.0 Client ID (Web application)
#   3. Add GOOGLE_REDIRECT_URI to the authorised redirect URIs
#   4. Visit BACKEND_URL/api/v1/integrations/google/authorize to mint a
#      refresh token, then paste it below.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                # [OPTIONAL]
GOOGLE_CLIENT_SECRET=            # [OPTIONAL]
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_REFRESH_TOKEN=            # [OPTIONAL]
GOOGLE_CALENDAR_ID=primary


# -----------------------------------------------------------------------------
# SLACK                                                             [OPTIONAL]
#
# Free workspace. https://api.slack.com/apps -> Create New App
# OAuth scopes: chat:write, chat:write.public
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=                 # [OPTIONAL] xoxb-...
SLACK_DEFAULT_CHANNEL=#onboarding


# -----------------------------------------------------------------------------
# JIRA                                                              [OPTIONAL]
#
# Free for up to 10 users. https://id.atlassian.com/manage-profile/security/api-tokens
# -----------------------------------------------------------------------------
JIRA_BASE_URL=                   # [OPTIONAL] https://your-site.atlassian.net
JIRA_USER_EMAIL=                 # [OPTIONAL]
JIRA_API_TOKEN=                  # [OPTIONAL]
JIRA_PROJECT_KEY=IT


# -----------------------------------------------------------------------------
# WORKFLOW POLICY
# -----------------------------------------------------------------------------
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
ESCALATION_TIMEOUT_SECONDS=3600
APPROVAL_REMINDER_SECONDS=900
REQUIRE_MANAGER_APPROVAL=true
DEFAULT_WORKFLOW_TEMPLATE=employee_onboarding


# -----------------------------------------------------------------------------
# FEATURE FLAGS
#
# Each integration stays simulated (and fully audited) while its flag is false,
# so the end-to-end demo never depends on external credentials.
# -----------------------------------------------------------------------------
ENABLE_EMAIL=false
ENABLE_REALTIME=true
ENABLE_LANGGRAPH=false           # [OPTIONAL] reserved for graph-based planning
ENABLE_LANGFUSE=false            # [OPTIONAL] reserved for LLM tracing
ENABLE_GOOGLE_CALENDAR=false
ENABLE_SLACK=false
ENABLE_JIRA=false
ENABLE_SEED=true                 # development-only demo data


# -----------------------------------------------------------------------------
# FRONTEND
#
# Only NEXT_PUBLIC_* variables reach the browser. Copy this block into
# frontend/.env.local. Never put the service role key here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ENABLE_REALTIME=true
